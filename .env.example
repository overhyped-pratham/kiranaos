# KiranaOS — Zero-Click Store Operator
# Environment Configuration Template (Backend)

# General Environment
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=https://your-frontend.vercel.app

# Database Configuration (Supabase PostgreSQL IPv4 Pooler)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# LLM & Embedding Model Settings
LLM_PROVIDER=auto
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Automations & Webhooks
N8N_WEBHOOK_URL=http://localhost:5678/webhook/kiranaos-order
N8N_ALERT_WEBHOOK_URL=http://localhost:5678/webhook/kiranaos-low-stock
DELIVERY_WEBHOOK_URL=http://localhost:8000/webhook/delivery-mock

# WhatsApp Cloud API Configuration
WHATSAPP_VERIFY_TOKEN=kiranaos_secret_token_2026
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MERCHANT_PHONE=+919876543210

# Business Constraints & Safety Thresholds
DEFAULT_DELIVERY_CHARGE=20.0
FREE_DELIVERY_THRESHOLD=500.0
HIGH_VALUE_APPROVAL_THRESHOLD=2500.0
HIGH_QUANTITY_APPROVAL_THRESHOLD=15

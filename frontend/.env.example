# KiranaOS — Frontend Environment Configuration Template (Vercel)

# Backend API Base URL (Render Web Service)
VITE_API_BASE_URL=https://your-render-backend.onrender.com

# Supabase Realtime & Client Configuration (Public/Publishable Keys ONLY)
# NEVER put SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY here!
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

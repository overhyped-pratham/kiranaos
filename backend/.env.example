# KiranaOS Environment Configuration

# Database: PostgreSQL / Supabase URL, or fallback to SQLite
DATABASE_URL=sqlite:///./kiranaos.db
# Example for Supabase/PostgreSQL:
# DATABASE_URL=postgresql://postgres.xxx:yyy@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# LLM & Embedding Providers (Hosted or Local Fallback)
# Model options: Qwen/Qwen2.5-3B-Instruct via HuggingFace or OpenAI-compatible endpoint
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=auto  # auto, huggingface, openai, groq, or local

# Embedding & Reranker models
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# n8n Automation & Webhooks
N8N_WEBHOOK_URL=http://localhost:5678/webhook/kiranaos-order
N8N_ALERT_WEBHOOK_URL=http://localhost:5678/webhook/kiranaos-low-stock
DELIVERY_WEBHOOK_URL=http://localhost:8000/webhook/delivery-mock

# WhatsApp Cloud API (if connecting directly without or with n8n)
WHATSAPP_VERIFY_TOKEN=kiranaos_secret_token_2026
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MERCHANT_PHONE=+919876543210
